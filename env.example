# Copie para .env (local) ou cadastre estas variaveis na stack do Dockhand.
# NAO commite o .env com valores reais.

# Dominio publico do Nextcloud (o mesmo do Proxy Host no NPM)
NC_DOMAIN=cloud.exemplo.com

# Nome da rede Docker onde o Nginx Proxy Manager esta (docker network ls)
NPM_NETWORK=proxy

# Sub-rede da rede do NPM (docker network inspect <rede>), ou o IP do container do NPM
TRUSTED_PROXIES=172.16.0.0/12

# IP do host do NPM (so se usar extra_hosts no servico talk)
NPM_HOST_IP=

# Admin inicial do Nextcloud
NC_ADMIN_USER=admin
NC_ADMIN_PASS=troque-esta-senha

# Segredos: gere cada um com  openssl rand -hex 32
DB_PASS=
REDIS_PASS=
TURN_SECRET=
SIGNALING_SECRET=
INTERNAL_SECRET=
